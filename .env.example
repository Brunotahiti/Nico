# Port HTTP du serveur
PORT=3000
# Dossier où sont conservés l'état (annonces vues, abonnements, clés VAPID)
DATA_DIR=./data
# Fréquence de vérification des sites, en minutes
CHECK_INTERVAL_MIN=5
# Adresse de contact transmise aux services push (Apple, Google)
VAPID_SUBJECT=mailto:vous@exemple.com
# Code à saisir dans l'application pour pouvoir s'abonner (laisser vide = ouvert à tous)
ACCESS_CODE=
# Clés VAPID (générées automatiquement au premier démarrage si absentes ;
# à renseigner sur un hébergeur sans disque persistant pour ne pas perdre les abonnements)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Relais facultatif (Cloudflare Worker, voir deploy/relay-worker.js) si le serveur
# ne peut pas joindre petitesannonces.pf directement
FETCH_RELAY_URL=
FETCH_RELAY_KEY=
# Hôtes passant par le relais (séparés par des virgules)
FETCH_RELAY_HOSTS=petitesannonces.pf
